<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.layout.Region?>
<HBox spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.photometal1.Controllers.LogAuditAdminController">

    <children>

        <!-- ΑΡΙΣΤΕΡΑ: ΜΕΝΟΥ (όπως στο Home) -->
        <VBox prefHeight="768.0" prefWidth="320.0" spacing="25.0">
            <children>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Photometal" textAlignment="CENTER">
                            <font>
                                <Font size="50.0" />
                            </font>
                        </Text>
                    </children>
                </HBox>

                <HBox prefHeight="92.0" prefWidth="310.0">
                    <children>
                        <Button maxHeight="60.0" maxWidth="220.0" mnemonicParsing="false" onAction="#onHelloButtonClick" prefHeight="60.0" prefWidth="220.0" text="Home">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                            </graphic>
                            <font>
                                <Font size="27.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="50.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <HBox prefHeight="92.0" prefWidth="310.0">
                    <children>
                        <Button maxHeight="60.0" maxWidth="220.0" mnemonicParsing="false" onAction="#onDocumentButtonClick" prefHeight="60.0" prefWidth="220.0" text="Documents">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                            </graphic>
                            <font>
                                <Font size="27.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="50.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <HBox prefHeight="92.0" prefWidth="310.0">
                    <children>
                        <Button maxHeight="60.0" maxWidth="220.0" mnemonicParsing="false" onAction="#onPlaygroundsButtonClickADD" prefHeight="60.0" prefWidth="220.0" text="Playgrounds">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                            </graphic>
                            <font>
                                <Font size="27.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="50.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <HBox prefHeight="92.0" prefWidth="310.0">
                    <children>
                        <Button maxHeight="60.0" maxWidth="220.0" mnemonicParsing="false" onAction="#onProductButtonClick" prefHeight="60.0" prefWidth="220.0" text="Products">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                            </graphic>
                            <font>
                                <Font size="27.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="50.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <HBox prefHeight="92.0" prefWidth="310.0">
                    <children>
                        <Button maxHeight="60.0" maxWidth="220.0" mnemonicParsing="false" onAction="#openLogView" prefHeight="60.0" prefWidth="220.0" text="Log ">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                            </graphic>
                            <font>
                                <Font size="27.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="50.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>

                <!-- 🔥 Logout button κάτω-κάτω -->
                <HBox>
                    <Button maxHeight="60.0"
                            maxWidth="220.0"
                            prefHeight="60.0"
                            prefWidth="220.0"
                            text="Logout"
                            onAction="#onLogoutClick">
                        <font>
                            <Font size="27.0"/>
                        </font>
                        <HBox.margin>
                            <Insets left="50.0" />
                        </HBox.margin>
                    </Button>
                </HBox>
            </children>
        </VBox>

        <!-- ΔΕΞΙΑ: LOG (ComboBox + TableView) -->
        <VBox prefHeight="768.0" prefWidth="1120.0" spacing="10">
            <children>
                <HBox spacing="10">
                    <Label text="Φιλτράρισμα ανά πίνακα:" />
                    <ComboBox fx:id="tableFilter" onAction="#loadLog" />
                </HBox>

                <TableView fx:id="logTable" prefHeight="600" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                        <TableColumn fx:id="userColumn" text="Χρήστης" />
                        <TableColumn fx:id="actionColumn" prefWidth="80" text="Action" />
                        <TableColumn fx:id="tableNameColumn" prefWidth="120" text="Table" />
                        <TableColumn fx:id="recordColumn" prefWidth="80" text="Record" />
                        <TableColumn fx:id="newDataColumn" prefWidth="200" text="New Data" />
                        <TableColumn fx:id="oldDataColumn" prefWidth="200" text="Old Data" />
                        <TableColumn fx:id="timeColumn" prefWidth="160" text="Time" />
                    </columns>
                </TableView>
            </children>
        </VBox>

    </children>
</HBox>
